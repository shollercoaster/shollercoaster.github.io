---
import '../styles/global.css';
import { site } from '../data/site';
import Icon from '../components/Icon.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = site.tagline } = Astro.props;

const navLinks = [
  { href: '/', label: 'About' },
  { href: '/resume', label: 'Resume' },
  { href: '/research', label: 'Research' },
  { href: '/blog', label: 'Blog' },
  { href: '/now', label: 'Now' },
  { href: '/contact', label: 'Contact' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700&display=swap" rel="stylesheet">

    <meta name="description" content={description} />
    <title>{title} · {site.name}</title>

    <!-- Apply dark mode before paint to avoid flash of wrong theme -->
    <script is:inline>
      const stored = localStorage.getItem('theme');
      const prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
      if (stored === 'dark' || (!stored && prefersDark)) {
        document.documentElement.classList.add('dark');
      }
    </script>
  </head>
  <body>
    <div class="max-w-3xl mx-auto px-6">
      <header class="flex items-center justify-between py-6 border-b" style="border-color: var(--color-border);">
        <a href="/" class="font-medium" style="color: var(--color-text);">{site.name}</a>
        <nav class="flex gap-5 text-sm" style="color: var(--color-text-muted);">
          {navLinks.map((link) => (
            <a href={link.href} class="hover:underline">{link.label}</a>
          ))}
        </nav>
        <button
          id="theme-toggle"
          aria-label="Toggle dark mode"
          style="color: var(--color-text-muted);"
        >
          <span id="theme-icon-moon" class="block">
            <Icon name="moon" class="w-4 h-4" />
          </span>
          <span id="theme-icon-sun" class="hidden">
            <Icon name="sun" class="w-4 h-4" />
          </span>
        </button>
      </header>

      <main class="py-10">
        <slot />
      </main>

      <footer class="border-t py-8 text-sm flex items-center justify-between" style="border-color: var(--color-border); color: var(--color-text-muted);">
        <p>&copy; {new Date().getFullYear()} {site.name}</p>
        <div class="flex gap-4">
          <a href={site.social.email} aria-label="Email"><Icon name="mail" class="w-4 h-4" /></a>
          <a href={site.social.linkedin} aria-label="LinkedIn"><Icon name="linkedin" class="w-4 h-4" /></a>
          <a href={site.social.github} aria-label="GitHub"><Icon name="github" class="w-4 h-4" /></a>
          <a href={site.social.scholar} aria-label="Google Scholar"><Icon name="scholar" class="w-4 h-4" /></a>
        </div>
      </footer>
    </div>

    <script is:inline>
      const toggle = document.getElementById('theme-toggle');
      const moonIcon = document.getElementById('theme-icon-moon');
      const sunIcon = document.getElementById('theme-icon-sun');

      function updateIcon() {
        const isDark = document.documentElement.classList.contains('dark');
        moonIcon?.classList.toggle('hidden', isDark);
        moonIcon?.classList.toggle('block', !isDark);
        sunIcon?.classList.toggle('hidden', !isDark);
        sunIcon?.classList.toggle('block', isDark);
      }
      updateIcon();

      toggle?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateIcon();
      });
    </script>
  </body>
</html>
