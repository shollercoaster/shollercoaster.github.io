---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<BaseLayout title="Contact" description="Get in touch.">
  <h1 class="text-2xl font-medium mb-4">Get in touch</h1>
  <p class="text-[15px] mb-8" style="color: var(--color-text-muted);">
    Whether it's about AI safety research, my published work, or anything
    else — feel free to reach out through any of these.
  </p>

  <div class="flex flex-col gap-3">
    <a
      href={site.social.email}
      class="flex items-center gap-3 p-4 rounded-xl border"
      style="border-color: var(--color-border); background: var(--color-surface);"
    >
      <Icon name="mail" class="w-5 h-5" />
      <div>
        <p class="text-sm font-medium">Email</p>
        <p class="text-xs" style="color: var(--color-text-faint);">Best for direct correspondence</p>
      </div>
    </a>

    <a
      href={site.social.linkedin}
      class="flex items-center gap-3 p-4 rounded-xl border"
      style="border-color: var(--color-border); background: var(--color-surface);"
    >
      <Icon name="linkedin" class="w-5 h-5" />
      <div>
        <p class="text-sm font-medium">LinkedIn</p>
        <p class="text-xs" style="color: var(--color-text-faint);">Professional background and updates</p>
      </div>
    </a>

    <a
      href={site.social.github}
      class="flex items-center gap-3 p-4 rounded-xl border"
      style="border-color: var(--color-border); background: var(--color-surface);"
    >
      <Icon name="github" class="w-5 h-5" />
      <div>
        <p class="text-sm font-medium">GitHub</p>
        <p class="text-xs" style="color: var(--color-text-faint);">Code for published and in-progress projects</p>
      </div>
    </a>

    <a
      href={site.social.scholar}
      class="flex items-center gap-3 p-4 rounded-xl border"
      style="border-color: var(--color-border); background: var(--color-surface);"
    >
      <Icon name="scholar" class="w-5 h-5" />
      <div>
        <p class="text-sm font-medium">Google Scholar</p>
        <p class="text-xs" style="color: var(--color-text-faint);">Publications and citation metrics</p>
      </div>
    </a>
  </div>
</BaseLayout>
