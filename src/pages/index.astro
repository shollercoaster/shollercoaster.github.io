---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site, categoryTagStyle } from '../data/site';
import { featuredResearch } from '../data/research';
import { getCollection } from 'astro:content';

// Latest 3 non-draft blog posts, newest first
const allPosts = await getCollection('blog', ({ data }) => !data.draft);
const recentPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const categoryLabels: Record<string, string> = {
  'ai-safety': 'AI safety',
  research: 'Research',
  productivity: 'Productivity',
  personal: 'Personal',
};
---

<BaseLayout title="About">
  <!-- Hero -->
  <div class="grid grid-cols-[90px_1fr] gap-6 items-start mb-10">
    <img
  src="/images/profile.jpeg"
  alt={site.name}
  class="w-[90px] h-[90px] rounded-full object-cover"
/>

    <div>
      <div class="flex items-baseline gap-2.5 mb-1.5 flex-wrap">
        <h1 class="text-2xl font-medium">Hi, I'm {site.name}</h1>
        <span class="text-sm" style="color: var(--color-text-faint);">{site.pronunciation}</span>
        <button
          id="play-pronunciation"
          aria-label="Play name pronunciation"
          style="color: var(--color-text-faint);"
        >
          <Icon name="volume" class="w-4 h-4" />
        </button>
        <audio id="pronunciation-audio" src={site.pronunciationAudio} preload="none"></audio>
      </div>
      <p class="text-base mb-4" style="color: var(--color-text-muted);">
        {site.tagline}
      </p>
      <div class="flex gap-3 text-sm">
        <a
          href="/resume"
          class="inline-flex items-center gap-1.5 px-4 py-2 rounded-lg border"
          style="border-color: var(--color-border); color: var(--color-text);"
        >
          View resume <Icon name="arrow-right" class="w-3.5 h-3.5" />
        </a>
        <a
          href="/blog"
          class="inline-flex items-center px-4 py-2 rounded-lg border"
          style="border-color: var(--color-border); color: var(--color-text);"
        >
          Read the blog
        </a>
      </div>
    </div>
  </div>

  <!-- Right now -->
  <div
    class="rounded-xl p-5 mb-8"
    style="background: var(--color-accent-soft);"
  >
    <p
      class="text-xs tracking-wide font-medium mb-2.5"
      style="color: var(--color-accent-text);"
    >
      RIGHT NOW
    </p>
    <ul class="text-sm space-y-2 pl-4 list-disc" style="color: var(--color-text);">
      {site.rightNow.map((item) => (
        <li>{item}</li>
      ))}
    </ul>
  </div>

  <!-- Bio -->
  <div class="mb-12">
    <p class="text-[15px] leading-relaxed" style="color: var(--color-text-muted);">
      {site.bio}
    </p>
  </div>

  <!-- Selected research -->
  <div class="mb-12">
    <h2 class="text-lg font-medium mb-4">Selected research</h2>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {featuredResearch.map((project) => (
        <a
          href={`/research#${project.slug}`}
          class="block rounded-xl p-4 border hover:shadow-sm transition"
          style="border-color: var(--color-border); background: var(--color-surface);"
        >
          <p class="text-xs mb-1" style="color: var(--color-text-faint);">{project.venue}</p>
          <p class="font-medium text-[15px] mb-1.5">{project.title}</p>
          <p class="text-[13px] mb-2" style="color: var(--color-text-muted);">
            {project.role}. Presented as a poster, in person.
          </p>
          <div class="flex gap-3.5 text-xs" style="color: var(--color-text-faint);">
            {project.links.arxiv && (
              <span class="inline-flex items-center gap-1">
                <Icon name="file-text" class="w-3.5 h-3.5" /> arXiv
              </span>
            )}
            {project.citations !== undefined && (
              <span class="inline-flex items-center gap-1">
                <Icon name="quote" class="w-3.5 h-3.5" /> {project.citations} citations
              </span>
            )}
            {project.links.poster && (
              <span class="inline-flex items-center gap-1">
                <Icon name="presentation" class="w-3.5 h-3.5" /> poster
              </span>
            )}
          </div>
        </a>
      ))}
    </div>
    <p class="text-xs mt-2.5" style="color: var(--color-text-faint);">
      <a href="/research" class="inline-flex items-center gap-1 hover:underline">
        + in-progress projects on the research page <Icon name="arrow-right" class="w-3 h-3" />
      </a>
    </p>
  </div>

  <!-- From the blog -->
  <div>
    <h2 class="text-lg font-medium mb-4">From the blog</h2>
    <div class="flex flex-col">
      {recentPosts.map((post) => (
        <a
          href={`/blog/${post.id}`}
          class="flex items-center justify-between py-2.5 border-b last:border-b-0"
          style="border-color: var(--color-border);"
        >
          <span class="text-sm">{post.data.title}</span>
          <span
            class="text-xs px-2.5 py-0.5 rounded-md whitespace-nowrap ml-4"
            style={categoryTagStyle(post.data.category)}
          >
            {categoryLabels[post.data.category]}
          </span>
        </a>
      ))}
    </div>
  </div>

  <script>
    const btn = document.getElementById('play-pronunciation');
    const audio = document.getElementById('pronunciation-audio') as HTMLAudioElement | null;
    btn?.addEventListener('click', () => {
      audio?.play().catch(() => {
        // Audio file may not exist yet - fail silently.
      });
    });
  </script>
</BaseLayout>
