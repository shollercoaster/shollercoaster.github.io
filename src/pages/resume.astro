---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---

<BaseLayout title="Resume" description="My resume.">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-medium">Resume</h1>
    <a href={site.resumePdf} download class="inline-flex items-center gap-1.5 text-sm px-4 py-2 rounded-lg border" style="border-color: var(--color-border); color: var(--color-text);">
      Download PDF <Icon name="arrow-right" class="w-3.5 h-3.5" />
    </a>
  </div>

  <iframe src={site.resumePdf} class="w-full rounded-xl border" style="border-color: var(--color-border); height: 85vh;" title="Resume PDF"></iframe>
</BaseLayout>